    "fullHtml": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <title>토스 아티클 & 보도자료 게시판</title>\n</head>\n<body class=\"bg-white dark:bg-[#0F172A] p-6 font-sans antialiased w-full\">\n  <div class=\"flex flex-col gap-10 items-start justify-start w-full\">\n    <!-- Category Capsule Tabs -->\n    <div class=\"flex flex-wrap gap-2 items-center justify-start w-full\">\n      <div class=\"bg-white dark:bg-slate-800 rounded-[40px] px-5 h-[43px] flex items-center justify-center text-[#333d4b] dark:text-slate-300 text-[17px] font-semibold tracking-tight opacity-60 cursor-pointer\">\n        전체\n      </div>\n      <div class=\"bg-white dark:bg-slate-800 rounded-[40px] px-5 h-[43px] flex items-center justify-center text-[#333d4b] dark:text-slate-300 text-[17px] font-semibold tracking-tight opacity-60 cursor-pointer\">\n        모두의 경험\n      </div>\n      <div class=\"bg-white dark:bg-slate-800 rounded-[40px] px-5 h-[43px] flex items-center justify-center text-[#333d4b] dark:text-slate-300 text-[17px] font-semibold tracking-tight opacity-60 cursor-pointer\">\n        안전한 기술\n      </div>\n      <div class=\"bg-[#f7ecb5] dark:bg-amber-400/20 rounded-[40px] px-5 h-[43px] flex items-center justify-center text-[#333d4b] dark:text-amber-300 text-[17px] font-semibold tracking-tight cursor-pointer\">\n        성장의 토대\n      </div>\n    </div>\n\n    <!-- Article Board List -->\n    <div class=\"w-full overflow-x-auto\">\n      <div class=\"flex flex-col gap-7 items-start justify-start w-full min-w-[720px]\">\n        <div class=\"flex flex-row items-center justify-start w-full gap-4 group cursor-pointer py-1\">\n          <div class=\"w-[92px] shrink-0\">\n            <span class=\"text-[#333d4b] dark:text-slate-400 text-[17px] leading-[27px] font-medium tracking-tight\">영상</span>\n          </div>\n          <div class=\