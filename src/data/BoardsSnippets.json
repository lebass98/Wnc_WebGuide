    "fullHtml": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <title>토스 아티클 & 보도자료 게시판</title>\n</head>\n<body class=\"bg-slate-50 dark:bg-[#0F172A] p-4 sm:p-8 flex justify-center items-center min-h-screen font-sans antialiased\">\n  <div class=\"w-full max-w-5xl bg-white dark:bg-[#1A222C] p-6 sm:p-10 rounded-[32px] border border-slate-100 dark:border-slate-800 shadow-sm flex flex-col gap-10 items-start justify-start\">\n    <!-- Category Capsule Tabs -->\n    <div class=\"flex flex-wrap gap-2 items-center justify-start w-full\">\n      <div class=\"bg-slate-100 dark:bg-slate-800 rounded-full px-5 h-[43px] flex items-center justify-center text-[#333d4b] dark:text-slate-300 text-[17px] font-semibold tracking-tight opacity-60 cursor-pointer\">\n        전체\n      </div>\n      <div class=\"bg-slate-100 dark:bg-slate-800 rounded-full px-5 h-[43px] flex items-center justify-center text-[#333d4b] dark:text-slate-300 text-[17px] font-semibold tracking-tight opacity-60 cursor-pointer\">\n        모두의 경험\n      </div>\n      <div class=\"bg-slate-100 dark:bg-slate-800 rounded-full px-5 h-[43px] flex items-center justify-center text-[#333d4b] dark:text-slate-300 text-[17px] font-semibold tracking-tight opacity-60 cursor-pointer\">\n        안전한 기술\n      </div>\n      <div class=\"bg-[#f7ecb5] dark:bg-amber-400/20 rounded-full px-5 h-[43px] flex items-center justify-center text-[#333d4b] dark:text-amber-300 text-[17px] font-semibold tracking-tight cursor-pointer\">\n        성장의 토대\n      </div>\n    </div>\n\n    <!-- Article Board List -->\n    <div class=\"w-full overflow-x-auto\">\n      <div class=\"flex flex-col gap-7 items-start justify-start w-full min-w-[720px]\">\n        <div class=\"flex flex-row items-center justify-start w-full gap-4 group cursor-pointer py-1\">\n          <div class=\"w-[92px] shrink-0